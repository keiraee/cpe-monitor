#!/bin/sh
# CPE Monitor CGI Script
# 采集系统状态和网络连接信息，输出 JSON

# HTTP 头
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo "Cache-Control: no-cache"
echo ""

# ========== 系统信息 ==========
UPTIME=$(cat /proc/uptime | awk '{print int($1)}')
LOAD=$(cat /proc/loadavg | awk '{print $1}')
LOAD5=$(cat /proc/loadavg | awk '{print $2}')
LOAD15=$(cat /proc/loadavg | awk '{print $3}')
MEM_TOTAL=$(free | awk '/Mem:/{print $2}')
MEM_USED=$(free | awk '/Mem:/{print $3}')
MEM_AVAIL=$(free | awk '/Mem:/{print $7}')
STOR_USED=$(df /overlay | awk 'NR==2{print $3}')
STOR_AVAIL=$(df /overlay | awk 'NR==2{print $4}')
CONNTRACK=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
CONNTRACK_MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 0)

# ========== DHCP 租约 ==========
LEASES=""
FIRST=1
while read EXPIRY MAC IP HOSTNAME ID; do
  [ -z "$IP" ] && continue
  [ "$IP" = "*" ] && continue
  if [ $FIRST -eq 1 ]; then FIRST=0; else LEASES="$LEASES,"; fi
  # 转义 hostname 中的特殊字符
  HOSTNAME=$(echo "$HOSTNAME" | sed 's/"/\\"/g')
  [ -z "$HOSTNAME" ] || [ "$HOSTNAME" = "*" ] && HOSTNAME="未知设备"
  LEASES="$LEASES{\"mac\":\"$MAC\",\"ip\":\"$IP\",\"hostname\":\"$HOSTNAME\"}"
done < /tmp/dhcp.leases 2>/dev/null

# ========== WiFi 接口发现 ==========
# 动态获取所有无线接口名，避免硬编码
WIFI_IFACES=$(ubus call network.wireless status 2>/dev/null | jsonfilter -e '@.*.interfaces[*].ifname')
if [ -z "$WIFI_IFACES" ]; then
  # fallback: 从 iwinfo 输出中提取接口名
  WIFI_IFACES=$(iwinfo 2>/dev/null | sed -n 's/^\([a-z0-9]*\)  .*/\1/p')
fi

# ========== WiFi 客户端 ==========
# 先建立 iface → essid 映射
IFACE_ESSID_MAP="/tmp/iface_essid_map.txt"
rm -f "$IFACE_ESSID_MAP"
for IFACE in $WIFI_IFACES; do
  INFO=$(iwinfo $IFACE info 2>/dev/null)
  ESSID=$(echo "$INFO" | sed -n 's/.*ESSID: *"\(.*\)".*/\1/p')
  [ -z "$ESSID" ] && ESSID="$IFACE"
  echo "$IFACE $ESSID" >> "$IFACE_ESSID_MAP"
done

WIFI_CLIENTS=""
FIRST=1
for IFACE in $WIFI_IFACES; do
  # 查找对应的 SSID
  ESSID=$(grep "^$IFACE " "$IFACE_ESSID_MAP" 2>/dev/null | cut -d' ' -f2-)
  [ -z "$ESSID" ] && ESSID="$IFACE"
  # 用 awk 解析多行 assoclist 输出，每个客户端占多行
  iwinfo $IFACE assoclist 2>/dev/null | awk -v iface="$ESSID" '
    /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/ {
      if (MAC != "") print MAC "|" iface "|" SIGNAL "|" RX "|" TX
      MAC = $1
      match($0, /[-][0-9]+/)
      SIGNAL = substr($0, RSTART, RLENGTH)
      RX = "N/A"; TX = "N/A"
    }
    /RX:/ { match($0, /[0-9.]+ M[Bb]it\/s/); if (RSTART) RX = substr($0, RSTART, RLENGTH-7) }
    /TX:/ { match($0, /[0-9.]+ M[Bb]it\/s/); if (RSTART) TX = substr($0, RSTART, RLENGTH-7) }
    END { if (MAC != "") print MAC "|" iface "|" SIGNAL "|" RX "|" TX }
  ' >> /tmp/wifi_clients_raw.txt 2>/dev/null
done

# 构建 MAC → 主机名 映射（从 DHCP 租约）
HOSTNAME_MAP="/tmp/mac_hostname_map.txt"
awk '{print toupper($2), $4}' /tmp/dhcp.leases 2>/dev/null > "$HOSTNAME_MAP" 2>/dev/null

# 组装 JSON（含设备名）
while IFS='|' read MAC IFACE SIGNAL RX_RATE TX_RATE; do
  [ -z "$MAC" ] && continue
  # 查找设备名
  HOSTNAME=$(grep -i "^$MAC " "$HOSTNAME_MAP" 2>/dev/null | awk '{print $2}')
  [ -z "$HOSTNAME" ] || [ "$HOSTNAME" = "*" ] && HOSTNAME="未知设备"
  if [ $FIRST -eq 1 ]; then FIRST=0; else WIFI_CLIENTS="$WIFI_CLIENTS,"; fi
  WIFI_CLIENTS="$WIFI_CLIENTS{\"mac\":\"$MAC\",\"iface\":\"$IFACE\",\"signal\":\"$SIGNAL\",\"rx_rate\":\"$RX_RATE\",\"tx_rate\":\"$TX_RATE\",\"hostname\":\"$HOSTNAME\"}"
done < /tmp/wifi_clients_raw.txt 2>/dev/null

# 清理临时文件
rm -f "$HOSTNAME_MAP" "$IFACE_ESSID_MAP"

# ========== WiFi 网络信息 ==========
WIFI_INFO=""
FIRST=1
for IFACE in $WIFI_IFACES; do
  INFO_OUTPUT=$(iwinfo $IFACE info 2>/dev/null)
  [ $? -ne 0 ] && continue
  
  ESSID=$(echo "$INFO_OUTPUT" | grep -oE 'ESSID: ".*"' | sed 's/ESSID: "//;s/"//')
  CHANNEL=$(echo "$INFO_OUTPUT" | grep "Channel" | grep -oE '[0-9]+' | head -1)
  [ -z "$CHANNEL" ] && CHANNEL="N/A"
  MODE=$(echo "$INFO_OUTPUT" | sed -n 's/.*Mode: *\([^ ]*\).*/\1/p' | tr -d '\r\n')
  [ -z "$MODE" ] && MODE="N/A"
  TXPOWER=$(echo "$INFO_OUTPUT" | grep "Tx-Power" | grep -oE '[0-9]+' | head -1)
  [ -z "$TXPOWER" ] && TXPOWER="N/A"
  
  [ -z "$ESSID" ] && continue
  
  if [ $FIRST -eq 1 ]; then FIRST=0; else WIFI_INFO="$WIFI_INFO,"; fi
  WIFI_INFO="$WIFI_INFO{\"iface\":\"$IFACE\",\"essid\":\"$ESSID\",\"channel\":\"$CHANNEL\",\"mode\":\"$MODE\",\"txpower\":\"$TXPOWER\"}"
done


# ========== 蜂窝网络信息 ==========
CELL_JSON='{}'

# 方法1: ubus modem 服务
CELL_UBUS=$(ubus call modem get_signal_info 2>/dev/null || ubus call network.modem status 2>/dev/null || ubus call mobiled signal 2>/dev/null)
if [ -n "$CELL_UBUS" ]; then
  NET_TYPE=$(echo "$CELL_UBUS" | jsonfilter -e '@.network_type' 2>/dev/null || echo "$CELL_UBUS" | jsonfilter -e '@.type' 2>/dev/null)
  SIG_QUAL=$(echo "$CELL_UBUS" | jsonfilter -e '@.signal_quality' 2>/dev/null || echo "$CELL_UBUS" | jsonfilter -e '@.quality' 2>/dev/null)
  RSSI=$(echo "$CELL_UBUS" | jsonfilter -e '@.rssi' 2>/dev/null)
  RSRQ=$(echo "$CELL_UBUS" | jsonfilter -e '@.rsrq' 2>/dev/null)
  RSCP=$(echo "$CELL_UBUS" | jsonfilter -e '@.rscp' 2>/dev/null)
  SINR=$(echo "$CELL_UBUS" | jsonfilter -e '@.sinr' 2>/dev/null)
  OPERATOR=$(echo "$CELL_UBUS" | jsonfilter -e '@.operator' 2>/dev/null)
  BAND=$(echo "$CELL_UBUS" | jsonfilter -e '@.band' 2>/dev/null)
  PCI=$(echo "$CELL_UBUS" | jsonfilter -e '@.pci' 2>/dev/null)
  if [ -n "$NET_TYPE" ]; then
    CELL_JSON="{\"net_type\":\"$NET_TYPE\",\"quality\":\"$SIG_QUAL\",\"rssi\":\"$RSSI\",\"rsrq\":\"$RSRQ\",\"rscp\":\"$RSCP\",\"sinr\":\"$SINR\",\"operator\":\"$OPERATOR\",\"band\":\"$BAND\",\"pci\":\"$PCI\"}"
  fi
fi

# 方法2: 读取 /tmp/ 缓存文件
if [ "$CELL_JSON" = "{}" ]; then
  for f in /tmp/modem_status /tmp/cellular_info /tmp/.modem_info /tmp/signal_info; do
    if [ -f "$f" ]; then
      NET_TYPE=$(grep -i 'network_type\|net_type\|type' "$f" 2>/dev/null | head -1 | sed 's/.*: *//')
      SIG_QUAL=$(grep -i 'quality\|signal_quality' "$f" 2>/dev/null | head -1 | sed 's/.*: *//' | tr -d '%')
      RSSI=$(grep -i 'rssi' "$f" 2>/dev/null | head -1 | sed 's/.*: *//' | grep -oE '[-]*[0-9]+')
      RSRQ=$(grep -i 'rsrq' "$f" 2>/dev/null | head -1 | sed 's/.*: *//' | grep -oE '[-]*[0-9]+')
      SINR=$(grep -i 'sinr' "$f" 2>/dev/null | head -1 | sed 's/.*: *//' | grep -oE '[-]*[0-9]+')
      BAND=$(grep -i 'band' "$f" 2>/dev/null | head -1 | sed 's/.*: *//')
      [ -n "$NET_TYPE" ] && CELL_JSON="{\"net_type\":\"$NET_TYPE\",\"quality\":\"$SIG_QUAL\",\"rssi\":\"$RSSI\",\"rsrq\":\"$RSRQ\",\"rscp\":\"$RSCP\",\"sinr\":\"$SINR\",\"band\":\"$BAND\"}" && break
    fi
  done
fi

# 方法3: AT 命令（通过 gcom/comgt）
if [ "$CELL_JSON" = "{}" ]; then
  for PORT in /dev/ttyUSB0 /dev/ttyUSB2 /dev/ttyACM0 /dev/ttyMTK1; do
    if [ -e "$PORT" ]; then
      AT_OUT=$(gcom -d "$PORT" -s /etc/gcom/getsignal.gcom 2>/dev/null || comgt -d "$PORT" sig 2>/dev/null)
      if [ -n "$AT_OUT" ]; then
        RSSI=$(echo "$AT_OUT" | grep -oE 'rssi:[^,]+' | grep -oE '[-]*[0-9]+' | head -1)
        RSCP=$(echo "$AT_OUT" | grep -oE 'rscp:[^,]+' | grep -oE '[-]*[0-9]+' | head -1)
        RSRQ=$(echo "$AT_OUT" | grep -oE 'rsrq:[^,]+' | grep -oE '[-]*[0-9]+' | head -1)
        [ -n "$RSSI" ] && CELL_JSON="{\"rssi\":\"${RSSI} dBm\",\"rscp\":\"${RSCP} dBm\",\"rsrq\":\"${RSRQ} dB\"}" && break
      fi
    fi
  done
fi

# ========== 输出 JSON ==========
cat << EOF
{
  "uptime": $UPTIME,
  "load": {
    "1m": "$LOAD",
    "5m": "$LOAD5",
    "15m": "$LOAD15"
  },
  "mem": {
    "total": $MEM_TOTAL,
    "used": $MEM_USED,
    "available": $MEM_AVAIL
  },
  "storage": {
    "used": $STOR_USED,
    "available": $STOR_AVAIL
  },
  "conntrack": {
    "count": $CONNTRACK,
    "max": $CONNTRACK_MAX
  },
  "leases": [$LEASES],
  "wifi_clients": [$WIFI_CLIENTS],
  "wifi_info": [$WIFI_INFO],
  "cellular": $CELL_JSON
}
EOF

# 清理临时文件
rm -f /tmp/wifi_clients_raw.txt
