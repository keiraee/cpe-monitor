#!/bin/sh
# CPE Monitor CGI Script
# 采集系统状态和网络连接信息，输出 JSON

echo "Content-Type: application/json"
echo "Cache-Control: no-cache"
echo ""

json_esc() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

int_or_zero() {
  case "$1" in
    ''|*[!0-9]*) printf '%s' "0" ;;
    *) printf '%s' "$1" ;;
  esac
}

WIFI_RAW="/tmp/cmonitor.$$.wifi"
ESSID_MAP="/tmp/cmonitor.$$.essid"
trap 'rm -f "$WIFI_RAW" "$ESSID_MAP"' EXIT
: > "$WIFI_RAW"
: > "$ESSID_MAP"

UPTIME=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
LOAD5=$(awk '{print $2}' /proc/loadavg 2>/dev/null)
LOAD15=$(awk '{print $3}' /proc/loadavg 2>/dev/null)
UPTIME=$(int_or_zero "$UPTIME")
[ -n "$LOAD" ] || LOAD="0.00"
[ -n "$LOAD5" ] || LOAD5="0.00"
[ -n "$LOAD15" ] || LOAD15="0.00"

MEM_TOTAL=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
MEM_AVAIL=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null)
if [ -z "$MEM_AVAIL" ]; then
  MEM_AVAIL=$(awk '
    /^MemFree:/ {f=$2}
    /^Buffers:/ {b=$2}
    /^Cached:/ {c=$2}
    END {print f+b+c}
  ' /proc/meminfo 2>/dev/null)
fi
MEM_TOTAL=$(int_or_zero "$MEM_TOTAL")
MEM_AVAIL=$(int_or_zero "$MEM_AVAIL")
MEM_USED=$((MEM_TOTAL - MEM_AVAIL))
[ "$MEM_USED" -lt 0 ] && MEM_USED=0

STOR_LINE=$(df /overlay 2>/dev/null | awk 'NR==2{print $3, $4}')
[ -n "$STOR_LINE" ] || STOR_LINE=$(df / 2>/dev/null | awk 'NR==2{print $3, $4}')
STOR_USED=$(echo "$STOR_LINE" | awk '{print $1}')
STOR_AVAIL=$(echo "$STOR_LINE" | awk '{print $2}')
STOR_USED=$(int_or_zero "$STOR_USED")
STOR_AVAIL=$(int_or_zero "$STOR_AVAIL")

CONNTRACK=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
CONNTRACK_MAX=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)
CONNTRACK=$(int_or_zero "$CONNTRACK")
CONNTRACK_MAX=$(int_or_zero "$CONNTRACK_MAX")

LEASES=""
FIRST=1
if [ -f /tmp/dhcp.leases ]; then
  while read -r _EXPIRY MAC IP REST; do
    [ -z "$IP" ] && continue
    [ "$IP" = "*" ] && continue
    HOSTNAME=$(printf '%s\n' "$REST" | awk '{
      if (NF <= 1) { print $1; exit }
      $NF = ""
      sub(/[ \t]+$/, "")
      print
    }')
    HOSTNAME=$(json_esc "$HOSTNAME")
    [ -z "$HOSTNAME" ] || [ "$HOSTNAME" = "*" ] && HOSTNAME="未知设备"
    MAC=$(json_esc "$MAC")
    IP=$(json_esc "$IP")
    if [ $FIRST -eq 1 ]; then FIRST=0; else LEASES="$LEASES,"; fi
    LEASES="$LEASES{\"mac\":\"$MAC\",\"ip\":\"$IP\",\"hostname\":\"$HOSTNAME\"}"
  done < /tmp/dhcp.leases
fi

WIFI_IFACES=$(ubus call network.wireless status 2>/dev/null | jsonfilter -e '@.*.interfaces[*].ifname')
if [ -z "$WIFI_IFACES" ]; then
  WIFI_IFACES=$(iwinfo 2>/dev/null | awk '/^[^[:space:]]+[[:space:]]+.*ESSID/ {print $1}')
fi

for IFACE in $WIFI_IFACES; do
  INFO=$(iwinfo "$IFACE" info 2>/dev/null)
  ESSID=$(printf '%s\n' "$INFO" | sed -n 's/.*ESSID: *"\(.*\)".*/\1/p')
  if [ -z "$ESSID" ]; then
    RAW_ESSID=$(printf '%s\n' "$INFO" | sed -n 's/.*ESSID: *//p' | awk '{print $1}')
    if [ -z "$RAW_ESSID" ] || [ "$RAW_ESSID" = "unknown" ]; then
      ESSID="(隐藏)"
    else
      ESSID="$RAW_ESSID"
    fi
  fi
  printf '%s %s\n' "$IFACE" "$ESSID" >> "$ESSID_MAP"
done

for IFACE in $WIFI_IFACES; do
  ESSID=$(awk -v iface="$IFACE" '$1 == iface { $1=""; sub(/^ /, ""); print; exit }' "$ESSID_MAP")
  [ -n "$ESSID" ] || ESSID="$IFACE"
  ESSID=$(printf '%s' "$ESSID" | tr '|' '/')
  iwinfo "$IFACE" assoclist 2>/dev/null | awk -v iface="$ESSID" '
    /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/ {
      if (MAC != "") print MAC "|" iface "|" SIGNAL "|" RX "|" TX
      MAC = $1
      match($0, /-[0-9]+/)
      SIGNAL = (RSTART ? substr($0, RSTART, RLENGTH) : "N/A")
      RX = "N/A"; TX = "N/A"
    }
    /RX:/ { match($0, /[0-9.]+ M[Bb]it\/s/); if (RSTART) RX = substr($0, RSTART, RLENGTH-7) }
    /TX:/ { match($0, /[0-9.]+ M[Bb]it\/s/); if (RSTART) TX = substr($0, RSTART, RLENGTH-7) }
    END { if (MAC != "") print MAC "|" iface "|" SIGNAL "|" RX "|" TX }
  ' >> "$WIFI_RAW"
done

WIFI_CLIENTS=""
FIRST=1
while IFS='|' read -r MAC IFACE SIGNAL RX_RATE TX_RATE; do
  [ -z "$MAC" ] && continue
  HOSTNAME=""
  if [ -f /tmp/dhcp.leases ]; then
    HOSTNAME=$(awk -v mac="$MAC" 'BEGIN { mac = toupper(mac) } toupper($2) == mac { print $4; exit }' /tmp/dhcp.leases)
  fi
  HOSTNAME=$(json_esc "$HOSTNAME")
  [ -z "$HOSTNAME" ] || [ "$HOSTNAME" = "*" ] && HOSTNAME="未知设备"
  MAC=$(json_esc "$MAC")
  IFACE=$(json_esc "$IFACE")
  SIGNAL=$(json_esc "$SIGNAL")
  RX_RATE=$(json_esc "$RX_RATE")
  TX_RATE=$(json_esc "$TX_RATE")
  if [ $FIRST -eq 1 ]; then FIRST=0; else WIFI_CLIENTS="$WIFI_CLIENTS,"; fi
  WIFI_CLIENTS="$WIFI_CLIENTS{\"mac\":\"$MAC\",\"iface\":\"$IFACE\",\"signal\":\"$SIGNAL\",\"rx_rate\":\"$RX_RATE\",\"tx_rate\":\"$TX_RATE\",\"hostname\":\"$HOSTNAME\"}"
done < "$WIFI_RAW"

WIFI_INFO=""
FIRST=1
for IFACE in $WIFI_IFACES; do
  INFO_OUTPUT=$(iwinfo "$IFACE" info 2>/dev/null) || continue
  [ -z "$INFO_OUTPUT" ] && continue
  ESSID=$(printf '%s\n' "$INFO_OUTPUT" | sed -n 's/.*ESSID: *"\(.*\)".*/\1/p')
  if [ -z "$ESSID" ]; then
    RAW_ESSID=$(printf '%s\n' "$INFO_OUTPUT" | sed -n 's/.*ESSID: *//p' | awk '{print $1}')
    if [ -z "$RAW_ESSID" ] || [ "$RAW_ESSID" = "unknown" ]; then
      ESSID="(隐藏)"
    else
      ESSID="$RAW_ESSID"
    fi
  fi
  CHANNEL=$(printf '%s\n' "$INFO_OUTPUT" | grep "Channel" | grep -oE '[0-9]+' | head -1)
  [ -z "$CHANNEL" ] && CHANNEL="N/A"
  MODE=$(printf '%s\n' "$INFO_OUTPUT" | sed -n 's/.*Mode: *\([^ ]*\).*/\1/p' | tr -d '\r\n')
  [ -z "$MODE" ] && MODE="N/A"
  TXPOWER=$(printf '%s\n' "$INFO_OUTPUT" | grep "Tx-Power" | grep -oE '[0-9]+' | head -1)
  [ -z "$TXPOWER" ] && TXPOWER="N/A"
  IFACE_ESC=$(json_esc "$IFACE")
  ESSID=$(json_esc "$ESSID")
  CHANNEL=$(json_esc "$CHANNEL")
  MODE=$(json_esc "$MODE")
  TXPOWER=$(json_esc "$TXPOWER")
  if [ $FIRST -eq 1 ]; then FIRST=0; else WIFI_INFO="$WIFI_INFO,"; fi
  WIFI_INFO="$WIFI_INFO{\"iface\":\"$IFACE_ESC\",\"essid\":\"$ESSID\",\"channel\":\"$CHANNEL\",\"mode\":\"$MODE\",\"txpower\":\"$TXPOWER\"}"
done

CELL_JSON='{}'
if [ -f /tmp/cpe_cell.file ] && [ -s /tmp/cpe_cell.file ]; then
  C_NET=$(sed -n '12p' /tmp/cpe_cell.file)
  if [ -n "$C_NET" ]; then
    C_NET=$(json_esc "$C_NET")
    C_QUAL=$(sed -n '13p' /tmp/cpe_cell.file | tr -d '%')
    C_RSSI=$(sed -n '14p' /tmp/cpe_cell.file | grep -oE '[-]*[0-9]+')
    C_RSRQ=$(sed -n '15p' /tmp/cpe_cell.file | grep -oE '[-]*[0-9]+')
    C_RSCP=$(sed -n '16p' /tmp/cpe_cell.file | grep -oE '[-]*[0-9]+')
    C_SINR=$(sed -n '17p' /tmp/cpe_cell.file | grep -oE '[-]*[0-9]+')
    C_OPR=$(json_esc "$(sed -n '7p' /tmp/cpe_cell.file)")
    C_MCC=$(json_esc "$(sed -n '18p' /tmp/cpe_cell.file)")
    C_LAC=$(sed -n '19p' /tmp/cpe_cell.file | awk '{print $1}')
    C_CID=$(json_esc "$(sed -n '20p' /tmp/cpe_cell.file)")
    C_BAND=$(json_esc "$(sed -n '21p' /tmp/cpe_cell.file)")
    C_PCI=$(json_esc "$(sed -n '23p' /tmp/cpe_cell.file)")
    C_QUAL=$(json_esc "$C_QUAL")
    C_RSSI=$(json_esc "$C_RSSI")
    C_RSRQ=$(json_esc "$C_RSRQ")
    C_RSCP=$(json_esc "$C_RSCP")
    C_SINR=$(json_esc "$C_SINR")
    C_LAC=$(json_esc "$C_LAC")
    CELL_JSON="{\"net_type\":\"$C_NET\",\"quality\":\"$C_QUAL\",\"rssi\":\"$C_RSSI\",\"rsrq\":\"$C_RSRQ\",\"rscp\":\"$C_RSCP\",\"sinr\":\"$C_SINR\",\"operator\":\"$C_OPR\",\"mcc_mnc\":\"$C_MCC\",\"lac\":\"$C_LAC\",\"cellid\":\"$C_CID\",\"band\":\"$C_BAND\",\"pci\":\"$C_PCI\"}"
  fi
fi

cat << EOF
{
  "uptime": $UPTIME,
  "load": { "1m": "$LOAD", "5m": "$LOAD5", "15m": "$LOAD15" },
  "mem": { "total": $MEM_TOTAL, "used": $MEM_USED, "available": $MEM_AVAIL },
  "storage": { "used": $STOR_USED, "available": $STOR_AVAIL },
  "conntrack": { "count": $CONNTRACK, "max": $CONNTRACK_MAX },
  "leases": [$LEASES],
  "wifi_clients": [$WIFI_CLIENTS],
  "wifi_info": [$WIFI_INFO],
  "cellular": $CELL_JSON
}
EOF
